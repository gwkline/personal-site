# Vite client environment. Copy this file to .env.local and fill in both
# values from your Convex dashboard or the output of npx convex dev.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Convex backend environment. Set each with: npx convex env set NAME value
SITE_URL=
CONVEX_SITE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
GITHUB_USERNAME=
GITHUB_TOKEN=

# Gym tracker coach (opencode-go / GLM-5.3). Convex deployment env only —
# the key never reaches the browser. See docs/gym/03-architecture.md.
OPENCODE_GO_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=glm-5.3

# Gym tracker accountability nudge (scripts/gym-nudge.ts). The flag itself
# lives in the app (gymSettings.nudgeEnabled); these only aim the script.
GYM_NUDGE_URL=
GYM_NUDGE_TO=

# Playwright overrides. Defaults live in playwright.config.ts, so leave these
# unset unless you are pointing the suite at an already running server.
PLAYWRIGHT_BASE_URL=
PW_WEB_SERVER_COMMAND=
