# Vite client environment. Copy this file to .env.local and fill in both
# values from your Convex dashboard or the output of npx convex dev.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Convex backend environment. Set each with: npx convex env set NAME value
SITE_URL=
CONVEX_SITE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OWNER_EMAIL=
GITHUB_USERNAME=
GITHUB_TOKEN=

# Playwright overrides. Defaults live in playwright.config.ts, so leave these
# unset unless you are pointing the suite at an already running server.
PLAYWRIGHT_BASE_URL=
PW_WEB_SERVER_COMMAND=
